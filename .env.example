# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/securevote?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change_me_to_a_64_byte_random_hex_string"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin (no trailing slash)
CLIENT_ORIGIN="http://localhost:5173"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to allow /api/auth/register (dev only; disable in production)
ALLOW_SELF_REGISTER="true"
